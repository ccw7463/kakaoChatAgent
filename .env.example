# 이 파일을 .env 로 복사한 뒤 값을 채워주세요.
#   cp .env.example .env

# [필수] OpenRouter API 키 (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# [필수] Supabase Postgres 연결 문자열
#   Supabase 대시보드 > Connect > Transaction pooler
#   (포트 6543 짜리를 쓰세요. 직결 주소는 IPv6 문제가 생길 수 있습니다)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# [선택] Tavily 검색 API 키 (https://app.tavily.com)
#   없으면 웹 검색 기능만 비활성화되고 나머지는 정상 동작합니다.
TAVILY_API_KEY=tvly-...

# [선택] 테이블을 격리할 스키마 이름. 기본값 kakao_agent
#   다른 프로젝트와 DB 를 공유할 때 이름 충돌과 REST API 노출을 막아줍니다.
# DB_SCHEMA=kakao_agent

# [선택] 사용할 모델. OpenRouter 의 모델 슬러그를 그대로 넣으면 됩니다.
#   https://openrouter.ai/models
# LLM_MODEL=google/gemini-3-flash-preview

# [선택] 서버가 스스로를 호출하는 웹훅 주소
#   비워두면 루프백(http://127.0.0.1:$PORT/webhook)을 사용합니다. 보통 손댈 필요 없습니다.
# WEBHOOK_URL=

# [선택] 메모리에 유지할 사용자 에이전트 수 상한 (LRU). 기본값 500
# MAX_AGENTS=500

# [선택] 서버 포트. Railway 등 PaaS 는 자동으로 주입하므로 비워두세요.
# PORT=7860
